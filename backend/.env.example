CAM_SERVER_ENV=development
CAM_DATABASE_URL=postgresql://camera_app:replace-locally@host.docker.internal:5432/camera_app
CAM_DB_POOL_SIZE=4
CAM_REQUEST_TIMEOUT_SECONDS=5
CAM_SESSION_TTL_SECONDS=600
CAM_DISCOVERY_TTL_SECONDS=90
CAM_STUN_URLS=[]
CAM_TURN_URLS=[]
CAM_API_PORT=8080
CAM_API_CPU_LIMIT=1.0
CAM_API_MEMORY_LIMIT=256m
